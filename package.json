{
  "name": "dsh-fakeip-fetch",
  "version": "0.5.2",
  "description": "Local HTTP fetch for DSH with opt-in TUN Fake-IP bypass and a first-run self check",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.js",
    "policy.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hariketsu/dsh-fakeip-fetch.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "fetch",
    "fake-ip",
    "tun",
    "clash",
    "mihomo",
    "ssrf"
  ],
  "scripts": {
    "test": "node --test test/policy.test.js",
    "test:client": "node test/client-bundle-check.mjs"
  }
}
